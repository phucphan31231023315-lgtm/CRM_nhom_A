<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_sgroup_assignment_history_tree" model="ir.ui.view">
        <field name="name">sgroup.assignment.history.tree</field>
        <field name="model">sgroup.assignment.history</field>
        <field name="arch" type="xml">
            <list string="Nhật ký phân lead" create="false" edit="false" decoration-danger="state == 'error'" decoration-success="state == 'success'">
                <field name="assignment_time"/>
                <field name="lead_id"/>
                <field name="employee_id"/>
                <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state == 'error'"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sgroup_assignment_history_form" model="ir.ui.view">
        <field name="name">sgroup.assignment.history.form</field>
        <field name="model">sgroup.assignment.history</field>
        <field name="arch" type="xml">
            <form string="Chi tiết nhật ký phân lead" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="lead_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="assignment_time"/>
                            <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state == 'error'"/>
                        </group>
                    </group>
                    <group string="Chi tiết / Ghi chú">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_sgroup_assignment_history_search" model="ir.ui.view">
        <field name="name">sgroup.assignment.history.search</field>
        <field name="model">sgroup.assignment.history</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm lịch sử">
                <field name="lead_id"/>
                <field name="employee_id"/>
                <separator/>
                <filter string="Thành công" name="success" domain="[('state', '=', 'success')]"/>
                <filter string="Lỗi / Cảnh báo" name="error" domain="[('state', '=', 'error')]"/>
                <group name="group_by">
                    <filter string="Nhân viên nhận" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Trạng thái" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sgroup_assignment_history" model="ir.actions.act_window">
        <field name="name">Nhật ký phân lead</field>
        <field name="res_model">sgroup.assignment.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sgroup_assignment_history_search"/>
        <field name="help" type="html">
            <p>
                Đây là nhật ký ghi lại toàn bộ tiến trình hệ thống phân phối lead tự động cho sale.
            </p>
        </field>
    </record>
</odoo>
