<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_sgroup_project_tree" model="ir.ui.view">
        <field name="name">sgroup.project.list</field>
        <field name="model">sgroup.project</field>
        <field name="arch" type="xml">
            <list string="Danh sách Dự án" decoration-info="active == True" decoration-muted="active == False">
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sgroup_project_form" model="ir.ui.view">
        <field name="name">sgroup.project.form</field>
        <field name="model">sgroup.project</field>
        <field name="arch" type="xml">
            <form string="Thông tin Dự án">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Ví dụ: Orchard Collection"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Cấu hình cơ bản">
                            <field name="code" placeholder="Ví dụ: ORCHARD"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_sgroup_project_search" model="ir.ui.view">
        <field name="name">sgroup.project.search</field>
        <field name="model">sgroup.project</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Dự án">
                <field name="name" string="Tên dự án"/>
                <field name="code" string="Mã dự án"/>
                <separator/>
                <filter string="Đang hoạt động" name="active" domain="[('active', '=', True)]"/>
                <filter string="Tạm ngưng" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sgroup_project" model="ir.actions.act_window">
        <field name="name">Quản lý Dự án</field>
        <field name="res_model">sgroup.project</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sgroup_project_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Thêm dự án mới
            </p>
            <p>
                Quản lý thông tin dự án bất động sản đang phân phối trên hệ thống.
            </p>
        </field>
    </record>
</odoo>
