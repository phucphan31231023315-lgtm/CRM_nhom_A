<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_sgroup_customer_tree" model="ir.ui.view">
        <field name="name">sgroup.customer.tree</field>
        <field name="model">sgroup.customer</field>
        <field name="arch" type="xml">
            <list string="Khách hàng" decoration-info="status == 'new'" decoration-success="status in ('potential', 'deposited')" decoration-danger="status == 'no_need'">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="project_id"/>
                <field name="employee_id"/>
                <field name="status" widget="badge" decoration-info="status == 'new'" decoration-warning="status == 'contacting'" decoration-success="status in ('potential', 'deposited')" decoration-danger="status == 'no_need'"/>
                <field name="level" widget="badge"/>
                <field name="source"/>
                <field name="created_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_sgroup_customer_form" model="ir.ui.view">
        <field name="name">sgroup.customer.form</field>
        <field name="model">sgroup.customer</field>
        <field name="arch" type="xml">
            <form string="Khách hàng">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Ví dụ: Nguyễn Thị B"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Thông tin liên hệ">
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="project_id" options="{'no_create': False}"/>
                            <field name="source" placeholder="Facebook, Google Ads, Giới thiệu..."/>
                        </group>
                        <group string="Phân loại &amp; Phụ trách">
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="status"/>
                            <field name="level"/>
                            <field name="created_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_sgroup_customer_graph" model="ir.ui.view">
        <field name="name">sgroup.customer.graph</field>
        <field name="model">sgroup.customer</field>
        <field name="arch" type="xml">
            <graph string="Thống kê Khách hàng" type="bar" sample="1">
                <field name="level" type="col"/>
                <field name="status"/>
            </graph>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_sgroup_customer_search" model="ir.ui.view">
        <field name="name">sgroup.customer.search</field>
        <field name="model">sgroup.customer</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Khách hàng">
                <field name="name"/>
                <field name="phone"/>
                <field name="employee_id"/>
                <field name="source"/>
                <separator/>
                <filter string="Khách mới" name="status_new" domain="[('status', '=', 'new')]"/>
                <filter string="Đang liên hệ" name="status_contacting" domain="[('status', '=', 'contacting')]"/>
                <filter string="Tiềm năng" name="status_potential" domain="[('status', '=', 'potential')]"/>
                <filter string="Chốt cọc" name="status_deposited" domain="[('status', '=', 'deposited')]"/>
                <filter string="Không nhu cầu" name="status_no_need" domain="[('status', '=', 'no_need')]"/>
                <separator/>
                <filter string="Cấp F1" name="level_f1" domain="[('level', '=', 'f1')]"/>
                <filter string="Cấp F2" name="level_f2" domain="[('level', '=', 'f2')]"/>
                <group name="group_by">
                    <filter string="Nhân viên phụ trách" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Trạng thái" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Cấp độ" name="group_by_level" context="{'group_by': 'level'}"/>
                    <filter string="Nguồn khách" name="group_by_source" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sgroup_customer" model="ir.actions.act_window">
        <field name="name">Danh sách Khách hàng</field>
        <field name="res_model">sgroup.customer</field>
        <field name="view_mode">list,form,graph</field>
        <field name="search_view_id" ref="view_sgroup_customer_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Thêm khách hàng đầu tiên
            </p>
            <p>
                Quản lý thông tin liên hệ, cấp độ F1-F5, nguồn lead và nhân viên phụ trách.
            </p>
        </field>
    </record>
</odoo>
