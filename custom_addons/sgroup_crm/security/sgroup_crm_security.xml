<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Category -->
        <record id="module_category_sgroup_crm" model="ir.module.category">
            <field name="name">Sgroup CRM</field>
            <field name="description">Phân quyền chức năng Sgroup CRM</field>
            <field name="sequence">100</field>
        </record>

        <!-- Privileges -->
        <record id="privilege_sgroup_crm_customer" model="res.groups.privilege">
            <field name="name">Quản lý khách hàng</field>
            <field name="category_id" ref="module_category_sgroup_crm"/>
        </record>

        <record id="privilege_sgroup_crm_employee" model="res.groups.privilege">
            <field name="name">Quản lý nhân viên</field>
            <field name="category_id" ref="module_category_sgroup_crm"/>
        </record>

        <record id="privilege_sgroup_crm_project" model="res.groups.privilege">
            <field name="name">Quản lý dự án</field>
            <field name="category_id" ref="module_category_sgroup_crm"/>
        </record>

        <record id="privilege_sgroup_crm_rule" model="res.groups.privilege">
            <field name="name">Quy tắc tự động</field>
            <field name="category_id" ref="module_category_sgroup_crm"/>
        </record>

        <record id="privilege_sgroup_crm_revenue" model="res.groups.privilege">
            <field name="name">Quản lý doanh thu</field>
            <field name="category_id" ref="module_category_sgroup_crm"/>
        </record>

        <record id="privilege_sgroup_crm_report" model="res.groups.privilege">
            <field name="name">Báo cáo</field>
            <field name="category_id" ref="module_category_sgroup_crm"/>
        </record>

        <record id="privilege_sgroup_crm_manager" model="res.groups.privilege">
            <field name="name">Quản trị viên (Toàn quyền)</field>
            <field name="category_id" ref="module_category_sgroup_crm"/>
        </record>

        <!-- Groups -->
        <record id="group_sgroup_crm_customer" model="res.groups">
            <field name="name">Cho phép</field>
            <field name="privilege_id" ref="privilege_sgroup_crm_customer"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sgroup_crm_employee" model="res.groups">
            <field name="name">Cho phép</field>
            <field name="privilege_id" ref="privilege_sgroup_crm_employee"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sgroup_crm_project" model="res.groups">
            <field name="name">Cho phép</field>
            <field name="privilege_id" ref="privilege_sgroup_crm_project"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sgroup_crm_rule" model="res.groups">
            <field name="name">Cho phép</field>
            <field name="privilege_id" ref="privilege_sgroup_crm_rule"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sgroup_crm_revenue" model="res.groups">
            <field name="name">Cho phép</field>
            <field name="privilege_id" ref="privilege_sgroup_crm_revenue"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sgroup_crm_report" model="res.groups">
            <field name="name">Cho phép</field>
            <field name="privilege_id" ref="privilege_sgroup_crm_report"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sgroup_crm_manager" model="res.groups">
            <field name="name">Cho phép</field>
            <field name="privilege_id" ref="privilege_sgroup_crm_manager"/>
            <field name="implied_ids" eval="[
                (4, ref('group_sgroup_crm_customer')),
                (4, ref('group_sgroup_crm_employee')),
                (4, ref('group_sgroup_crm_project')),
                (4, ref('group_sgroup_crm_rule')),
                (4, ref('group_sgroup_crm_revenue')),
                (4, ref('group_sgroup_crm_report'))
            ]"/>
            <field name="implied_by_ids" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>

    <!-- Record Rules -->
    <data noupdate="0">
        <!-- Customer Rules -->
        <record id="rule_sgroup_customer_sale" model="ir.rule">
            <field name="name">Sgroup CRM: Sale chỉ xem khách hàng phụ trách</field>
            <field name="model_id" ref="model_sgroup_customer"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sgroup_crm_customer'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_sgroup_customer_manager" model="ir.rule">
            <field name="name">Sgroup CRM: Quản trị viên xem tất cả khách hàng</field>
            <field name="model_id" ref="model_sgroup_customer"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sgroup_crm_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Ad Data Rules -->
        <record id="rule_sgroup_ad_data_sale" model="ir.rule">
            <field name="name">Sgroup CRM: Sale chỉ xem dữ liệu quảng cáo phụ trách</field>
            <field name="model_id" ref="model_sgroup_ad_data"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sgroup_crm_customer'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_sgroup_ad_data_manager" model="ir.rule">
            <field name="name">Sgroup CRM: Quản trị viên xem tất cả dữ liệu quảng cáo</field>
            <field name="model_id" ref="model_sgroup_ad_data"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sgroup_crm_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>
